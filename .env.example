# Copia este archivo a `.env` y ajusta los valores.
# En esta fase inicial el backend funciona con los valores por defecto,
# así que `.env` es opcional por ahora.

# Host donde escucha el servidor. 0.0.0.0 permite acceso desde otros dispositivos (p.ej. iPhone).
# LUMINA_HOST=0.0.0.0

# Puerto del servidor.
# LUMINA_PORT=8000

# Token de API para autenticar el dashboard (X-API-Key / Bearer).
# Genera uno largo, p. ej.:  openssl rand -hex 32
# LUMINA_TOKEN=
