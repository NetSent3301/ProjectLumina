# ProjectLumina — variables de entorno
# Copia a .env y ajusta:
#   cp .env.example .env

# Token de API (obligatorio si expones el puerto en LAN/Internet)
# Si vacío, la API no requiere autenticación (solo desarrollo local)
LUMINA_TOKEN=

# Puerto interno (el contenedor siempre escucha en 8127)
LUMINA_PORT=8127

# Base de datos (dentro del contenedor /app/data/lumina.db)
LUMINA_DB=/app/data/lumina.db

# Debug (true/false)
LUMINA_DEBUG=false

# Contraseña de sudo (opcional) para operaciones privilegiadas del panel:
# crear unidades systemd, terminal, etc. Si vacía, el panel usa `sudo -n`
# y depende de una regla visudo del usuario. NO la pongas en ningún repo.
LUMINA_SUDO_PASSWORD=