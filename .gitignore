# Dependencias
node_modules/
vendor/
# Excepción: librerías estáticas del frontend referenciadas en el HTML
# (xterm.js + addons), que se envían sin build/npm.
!web/static/vendor/
web/static/vendor/*
!web/static/vendor/xterm/

# Entornos virtuales de Python
venv/
.venv/

# Caches
__pycache__/
*.py[cod]
.pytest_cache/

# Archivos de entorno y secretos
.env
.env.*
!.env.example
*.pem
*.key

# Builds y distribuciones
dist/
build/
out/
coverage/
*.egg-info/

# Plataforma / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Configuración local de Obsidian
.obsidian/
workspace.json
workspace-mobile.json

# Logs
*.log
logs/

# Base de datos y temporales
*.sqlite
*.sqlite3
data/
tmp/
temp/
